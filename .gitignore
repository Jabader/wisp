*.ptx

# Dependencies
venv/
.venv/
.env
.env.local
*.env.*

# Build systems
build/
dist/
target/
*.egg-info/
.pytest_cache/
.mypy_cache/

# Editors
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Logs
*.log

# OS
.DS_Store
Thumbs.db

# Coverage
coverage/
htmlcov/
.coverage

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst
```